# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Claude workspace internals
.claude/

# Node modules (if any)
# No trailing slash: also catches symlinked node_modules
# (e.g. 01 - Website/feature-graphic/node_modules -> ~/node_modules)
node_modules

# Environment files
.env
.env.local

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Nested git repo (has its own .git — push separately)
04 - Design System & Storybook/

# The Room Parent Portal prototype is its own repo now, with its own history,
# releases, and Vercel deploy: github.com/Fauz2808/roomparent-portal
# Edit it in place; it is ignored here so it stops showing up as untracked.
01 - Website/room-parent-portal-redesign/

# Vercel project links. Not secrets, but they bind a folder to a live project:
# an archived copy of the portal still carried one pointing at production, which
# would have let anyone deploy a three-week-old build over the live site.
.vercel/

# Tool workspaces, same reasoning as .claude/ above. The impeccable review folder
# alone holds 190MB of screen-recording MP4s that are artefacts, not design work.
.impeccable/
